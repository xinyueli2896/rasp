__pycache__/
*.pyc
*.pyo
*.pyd
.Python
checkpoints/
*.pt
*.egg-info/
dist/
build/
.env
# `data/*` not `data/`: git cannot re-include a file whose parent
# DIRECTORY is excluded, so the negation below only works this way.
# The .pt tensors stay ignored; the dataset definitions are source.
data/*
!data/*.py
input/

# generated artefacts — regenerable, keep them out of git status
eval_logs_grid/
wandb/
lightning_logs/
eval_midi*/
gen_midi*/
decoded_midi/
figures/*.png

# local helper scripts kept out of version control
preprocess_large_midi_dataset.py
pretty_midi_fix.py
settings.py

# Compiled Tracr rule models are COMMITTED: they are ~160 KB each and
# regenerating them needs tracr+jax, which nothing else in this repo
# requires. Keeping them here makes the rule model usable from a
# plain `git pull`.
!models/compiled_rules/
!models/compiled_rules/*.pt

# Slurm job logs. The directory itself is tracked via .gitkeep because
# Slurm opens --output before the script runs and fails if it is absent.
slurm_logs/*
!slurm_logs/.gitkeep
